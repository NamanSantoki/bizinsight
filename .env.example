# ─── BIZINSIGHT Enterprise Environment Configuration ───

# Security & Tokens
SECRET_KEY=change-in-production-super-secure-token-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Connection (PostgreSQL 16 recommended for production)
DATABASE_URL=sqlite:///./bizinsight.db
# DATABASE_URL=postgresql://bizuser:bizpassword2026@localhost:5432/bizinsight

# Storage Directories
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
SAMPLES_DIR=./data/samples
MODELS_DIR=./ml/models

# Ollama / Local LLM Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Safe Query Execution Controls
MAX_QUERY_TIMEOUT_SECONDS=15
MAX_QUERY_ROW_LIMIT=1000

